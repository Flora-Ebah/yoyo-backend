{
  "name": "yoyo-api",
  "version": "1.0.16",
  "description": "API backend pour l'application YoYo",
  "main": "build/main.js",
  "scripts": {
    "start": "node build/main.js",
    "dev": "tsc && nodemon build/main.js",
    "build": "tsc",
    "test": "mocha",
    "deploy": "git pull origin main && pm2 start ecosystem.config.js",
    "deploy:dev": "git pull origin dev && pm2 start ecosystem.config.js --env development",
    "deploy:prod": "git pull origin main && pm2 start ecosystem.config.js --env production",
    "seed": "node seed.js",
    "seed:categories": "node seed.js --categories",
    "seed:plans": "node seed.js --plans",
    "seed:admin": "node seed.js --admin",
    "seed:clean": "node seed.js --clean",
    "cron:test": "node src/scripts/test-subscription-cron.js",
    "cron:run": "node src/scripts/run-subscription-cron.js",
    "pm2:start": "yarn build && pm2 start ecosystem.config.js",
    "pm2:start:prod": "yarn build && pm2 start ecosystem.config.js --env production",
    "test:security": "mocha --spec \"src/tests/**/*.security.test.ts\""
  },
  "keywords": [
    "yoyo",
    "api",
    "backend",
    "nodejs",
    "typescript"
  ],
  "author": "YoYo Team",
  "license": "MIT",
  "dependencies": {
    "@azure/msal-node": "^3.1.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.1.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@types/cron": "^2.4.0",
    "coddyger": "^1.3.29",
    "cron": "^3.1.7",
    "fastify": "^4.28.1",
    "fastify-multer": "^2.0.3",
    "google-auth-library": "^9.14.2",
    "handlebars": "^4.7.8",
    "ioredis": "^5.6.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "ldap-authentication": "^3.2.6",
    "mammoth": "^1.4.21",
    "mime-types": "^2.1.35",
    "multer": "1.4.5-lts.1",
    "natural": "^8.0.1",
    "node-nlp": "^4.27.0",
    "nodemailer": "^6.9.15",
    "nodemon": "^3.1.5",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.7.5",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.5",
    "@types/nodemailer": "^6.4.16",
    "@types/sinon": "^10.0.0",
    "chai": "^4.3.0",
    "mocha": "^10.0.0",
    "mongodb-memory-server": "^8.12.0",
    "nyc": "^15.1.0",
    "sinon": "^15.0.0",
    "socket.io-client": "^4.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
