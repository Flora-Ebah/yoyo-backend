# ============================================
# CONFIGURATION GÉNÉRALE
# ============================================
ENV=dev # dev | prod
APP_NAME=YOYO La Carte
SERVER_PORT=3014
SERVER_HOST=http://localhost:3014
SERVER_PATH=/yoyo
API_VERSION=v1
ORIGINS="*"

# ============================================
# BASE DE DONNÉES
# ============================================
USE_DB=yes
DB_URI="mongodb://username:password@localhost:27017"
DB_NAME=yoyo

# ============================================
# SESSION JWT TOKEN
# ============================================
# Générer des secrets aléatoires sécurisés (minimum 32 caractères)
JWT_SECRET=your-secret-jwt-key-minimum-32-characters-long
JWT_AUTH_SECRET=your-auth-secret-key
# [C-01, 02/09/2026] `JWT_PUBLIC` a été retirée. Elle servait la route `POST /get-token`, qui
# échangeait une clé écrite en dur dans les 4 applications contre un jeton signé avec JWT_SECRET.
# Ce jeton ne désignait aucun utilisateur et franchissait pourtant l'authentification sur toutes
# les routes. La route est supprimée, `verify` refuse désormais tout jeton sans `_id`, et
# l'attestation d'application a pris le relais (voir plus bas). Retirer la variable des
# environnements existants : le contrôle de démarrage la signale tant qu'elle est présente.
JWT_TOKEN_EXPIRE="365d"
DEFAULT_ACCOUNT="admin@yoyocarte.com:your-password"

# ============================================
# Orange Money WebPay
# ============================================
# NB : l'intégration CinetPay a été retirée (prestataire abandonné). Les variables CINETPAY_*
# ne sont plus lues par l'application et peuvent être supprimées des environnements.
OM_HOST=https://api.orange.com
OM_MERCHANT_KEY=your-orange-merchant-key
OM_BASIC_CONSUMER_KEY="Basic your-base64-encoded-credentials"
OM_CURRENCY=OUV
OM_RETURN_URL=https://your-domain.com/v1/yoyo/transaction/payment-return
OM_NOTIFY_URL=https://your-domain.com/v1/yoyo/transactions/payment-notify
OM_ENV=dev # dev or ci

# Allowlist d'IP autorisées à appeler /transactions/payment-notify (séparées par des virgules).
# Défense en profondeur : laisser vide désactive le filtre (dev/recette). La sécurité repose
# de toute façon sur la revalidation du statut auprès d'Orange Money.
OM_NOTIFY_ALLOWED_IPS=

# ============================================
# MONNAIE
# ============================================
CURRENCY="XOF"
CURRENCY_SYMBOL="FCFA"

# ============================================
# MAILER (SMTP) — TITAN EMAIL
# ============================================
# [02/09/2026] Le SMTP Gmail a été remplacé par la boîte Titan `no-reply@yoyolacarte.com`.
# Un seul fichier envoie des mails — `src/services/notification/email.service.ts` — et il lit
# uniquement ces variables : changer de fournisseur ne demande aucune modification de code.
MAILER_HOST=smtp.titan.email
MAILER_USER=no-reply@yoyolacarte.com
# Mot de passe de la boîte Titan (Titan n'a pas de « mot de passe d'application » à la Gmail :
# c'est le mot de passe du compte lui-même). Ne jamais le versionner.
MAILER_PASSWORD=your-titan-mailbox-password

# Port et chiffrement vont par paire, ne pas les croiser :
#   465 -> MAILER_SECURE=true   (TLS ouvert d'emblée — recommandé chez Titan)
#   587 -> MAILER_SECURE=false  (connexion en clair passée en TLS par STARTTLS)
# Croiser les deux ne renvoie pas d'erreur : la connexion reste pendue jusqu'au délai d'expiration.
# Si `MAILER_SECURE` est laissée vide, le code la déduit du port.
MAILER_PORT=465
MAILER_SECURE=true

# Expéditeur affiché. Doit désigner la boîte de `MAILER_USER` ou l'un de ses alias déclarés chez
# Titan : tout autre expéditeur est refusé en 550, y compris sur un domaine voisin.
MAILER_FROM=YOYO La Carte <no-reply@yoyolacarte.com>

# URL publique servant les images des e-mails (logo d'en-tête), exposée par la route statique
# `${SERVER_HOST}/${API_VERSION}${SERVER_PATH}/assets`. Sans rapport avec le domaine du SMTP :
# c'est l'API qui sert ces images. ⚠️ À trancher — le reste du fichier utilise `yoyocarte.com`
# (sans « la ») alors que la boîte Titan est sur `yoyolacarte.com`. Vérifier quel domaine est
# réellement déployé avant de figer celui-ci et `PRO_APP_URL`.
MAIL_ASSETS_URL=https://api.yoyocarte.com/v1/yoyo/assets

# ============================================
# SUPPORT
# ============================================
# Sert d'adresse de réponse (`Reply-To`) sur tous les envois : l'expéditeur étant une boîte
# `no-reply`, sans cette variable la réponse d'un marchand à son mail d'activation part dans le vide.
# Peut être sur un autre domaine que le SMTP — `Reply-To` n'est pas authentifié par le serveur.
SUPPORT_EMAIL=info@yoyocarte.com

# ============================================
# UPLOAD DE FICHIERS
# ============================================
ALLOWED_FILE_TYPES=".pdf,.doc,.docx,.jpg,.jpeg,.png,.txt,.xls,.xlsx"
ALLOWED_FILE_SIZE=10 # Taille maximale en MB

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER_DB=1

# ============================================
# GOOGLE AUTH (Optionnel)
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
DEFAULT_PROFILE_ID=your-default-profile-id

# ============================================
# KAFKA (Optionnel)
# ============================================
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT=yoyo-api
KAFKA_TOPIC=yoyo-events
KAFKA_GROUP=yoyo-consumer-group
KAFKA_FOREIGNERS=yoyo-foreigners

# ============================================
# RABBITMQ (Optionnel)
# ============================================
RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_GLOBAL_EXCHANGE=yoyo-exchange

# ============================================
# SIGOBE (Optionnel)
# ============================================
SIGOBE_ENABLED=false
SIGOBE_API_URL=https://api.sigobe.com
SIGOBE_API_KEY=your-sigobe-api-key
SIGOBE_SYNC_INTERVAL=30 # minutes
SIGOBE_RETRY_ATTEMPTS=3
SIGOBE_RETRY_DELAY=300 # seconds

# ============================================
# BROADCAST (Optionnel)
# ============================================
BROADCAST_SECRET=your-broadcast-secret-key

# ============================================
# REDIS AVANCÉ (Optionnel)
# ============================================
REDIS_DATABASE=0
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_APPENDONLY=yes
REDIS_TLS_ENABLED=false

# ============================================
# ONBOARDING MARCHAND À DISTANCE
# ============================================
# URL de base de l'application Partenaire (yoyo-pro). Le lien d'activation envoyé au marchand
# est construit ainsi : ${PRO_APP_URL}/activation?token=...
# Sans cette variable, aucun lien n'est envoyé et l'onboarding répond activationSent:false.
PRO_APP_URL=https://pro.yoyocarte.com
# Durée de validité du lien d'activation, en heures (défaut : 72).
ACTIVATION_TOKEN_TTL_HOURS=72

# ============================================
# SMS — ORANGE SMS CÔTE D'IVOIRE (Optionnel)
# ============================================
# Sans ORANGE_SMS_AUTH_HEADER et ORANGE_SMS_SENDER_ADDRESS, le canal SMS est simplement désactivé :
# le service se déclare indisponible et les envois se font par e-mail uniquement.
ORANGE_SMS_HOST=https://api.orange.com
# En-tête Authorization complet de l'appel OAuth, tel que fourni par Orange Developer.
# Générer : echo -n "<client_id>:<client_secret>" | base64   puis préfixer par "Basic ".
ORANGE_SMS_AUTH_HEADER=Basic your-base64-encoded-credentials
# Numéro émetteur enregistré auprès d'Orange, au format tel:+225XXXXXXXXXX
ORANGE_SMS_SENDER_ADDRESS=tel:+225XXXXXXXXXX
# Nom d'expéditeur affiché. Doit être enregistré auprès de l'ARTCI / des opérateurs.
ORANGE_SMS_SENDER_NAME=YoYo

# ==============================================
# ATTESTATION D'APPLICATION — FIREBASE APP CHECK
# ==============================================
# [C-01] Depuis la suppression du jeton public, c'est le **seul** contrôle d'origine sur les
# 8 routes d'avant-connexion : inscription, connexion, OTP, mot de passe oublié, activation d'un
# compte marchand. Le contrôle de démarrage avertit — sans jamais bloquer — quand la posture
# ci-dessous laisse ces routes ouvertes.
APP_CHECK_ENABLED=true

# Rejet global. Attend que **toutes** les applications envoient une attestation, `yoyo-admin-main`
# comprise, et surtout que le parc installé ait migré : une version publiée avant App Check
# n'envoie rien, et ses utilisateurs perdraient inscription et mot de passe oublié.
APP_CHECK_ENFORCE=false

# Rejet route par route, **avant** l'interrupteur global. Liste de chemins séparés par des
# virgules — pas un booléen. Comparaison par fragment, en minuscules, sur le chemin déclaré de la
# route. Permet de fermer ce qu'aucune application en retard n'appelle.
# Exemple : APP_CHECK_ENFORCE_ROUTES=/clients/register,/otp/password-reset/request
APP_CHECK_ENFORCE_ROUTES=

# Détection du rejeu sur `POST /otp/verify` et `PUT /clients/updatePassword`. Deux prérequis :
# le rôle IAM « Firebase App Check Token Verifier » sur le compte de service, et des clients qui
# envoient un jeton à usage unique sur ces routes. Sans le rôle, la détection se coupe d'elle-même
# après un échec, en le journalisant.
APP_CHECK_CONSUME=false

# ==============================================
# COMPTE DE SERVICE FIREBASE — SECRET
# ==============================================
FIREBASE_PROJECT_ID=yoyo-la-carte-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@yoyo-la-carte-xxxxx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
