# ============================================
# CONFIGURATION GÉNÉRALE
# ============================================
ENV=dev # dev | prod
APP_NAME=YOYO La Carte
SERVER_PORT=3014
SERVER_HOST=http://localhost:3014
SERVER_PATH=/yoyo
API_VERSION=v1
ORIGINS="*"

# ============================================
# BASE DE DONNÉES
# ============================================
USE_DB=yes
DB_URI="mongodb://username:password@localhost:27017"
DB_NAME=yoyo

# ============================================
# SESSION JWT TOKEN
# ============================================
# Générer des secrets aléatoires sécurisés (minimum 32 caractères)
JWT_SECRET=your-secret-jwt-key-minimum-32-characters-long
JWT_PUBLIC=your-public-jwt-key
JWT_AUTH_SECRET=your-auth-secret-key
JWT_TOKEN_EXPIRE="365d"
DEFAULT_ACCOUNT="admin@yoyocarte.com:your-password"

# ============================================
# Orange Money WebPay
# ============================================
# NB : l'intégration CinetPay a été retirée (prestataire abandonné). Les variables CINETPAY_*
# ne sont plus lues par l'application et peuvent être supprimées des environnements.
OM_HOST=https://api.orange.com
OM_MERCHANT_KEY=your-orange-merchant-key
OM_BASIC_CONSUMER_KEY="Basic your-base64-encoded-credentials"
OM_CURRENCY=OUV
OM_RETURN_URL=https://your-domain.com/v1/yoyo/transaction/payment-return
OM_NOTIFY_URL=https://your-domain.com/v1/yoyo/transactions/payment-notify
OM_ENV=dev # dev or ci

# Allowlist d'IP autorisées à appeler /transactions/payment-notify (séparées par des virgules).
# Défense en profondeur : laisser vide désactive le filtre (dev/recette). La sécurité repose
# de toute façon sur la revalidation du statut auprès d'Orange Money.
OM_NOTIFY_ALLOWED_IPS=

# ============================================
# MONNAIE
# ============================================
CURRENCY="XOF"
CURRENCY_SYMBOL="FCFA"

# ============================================
# MAILER (SMTP)
# ============================================
MAILER_USER=your-email@gmail.com
MAILER_PASSWORD=your-app-password
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
MAILER_SECURE=false
MAILER_FROM=YOYO La Carte<info@yoyocarte.com>

# ============================================
# SUPPORT
# ============================================
SUPPORT_EMAIL=info@yoyocarte.com

# ============================================
# UPLOAD DE FICHIERS
# ============================================
ALLOWED_FILE_TYPES=".pdf,.doc,.docx,.jpg,.jpeg,.png,.txt,.xls,.xlsx"
ALLOWED_FILE_SIZE=10 # Taille maximale en MB

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER_DB=1

# ============================================
# GOOGLE AUTH (Optionnel)
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
DEFAULT_PROFILE_ID=your-default-profile-id

# ============================================
# KAFKA (Optionnel)
# ============================================
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT=yoyo-api
KAFKA_TOPIC=yoyo-events
KAFKA_GROUP=yoyo-consumer-group
KAFKA_FOREIGNERS=yoyo-foreigners

# ============================================
# RABBITMQ (Optionnel)
# ============================================
RABBITMQ_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_GLOBAL_EXCHANGE=yoyo-exchange

# ============================================
# SIGOBE (Optionnel)
# ============================================
SIGOBE_ENABLED=false
SIGOBE_API_URL=https://api.sigobe.com
SIGOBE_API_KEY=your-sigobe-api-key
SIGOBE_SYNC_INTERVAL=30 # minutes
SIGOBE_RETRY_ATTEMPTS=3
SIGOBE_RETRY_DELAY=300 # seconds

# ============================================
# BROADCAST (Optionnel)
# ============================================
BROADCAST_SECRET=your-broadcast-secret-key

# ============================================
# REDIS AVANCÉ (Optionnel)
# ============================================
REDIS_DATABASE=0
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_APPENDONLY=yes
REDIS_TLS_ENABLED=false
